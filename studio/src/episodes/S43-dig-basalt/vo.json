    "seconds": 2.82,
    "pauseAfter": 0.55
  },
  {
    "scene": "cold",
    "index": 4,
    "text": "No basalt. Just gneiss, an old, granite-like rock, all the way through.",
    "file": "S43-dig-basalt/vo/cold-04-91799120b7.wav",
    "seconds": 4.88,
    "pauseAfter": 0.55
  },
  {
    "scene": "cold",
    "index": 5,
    "text": "That's the kind of thing you only learn by going there.",

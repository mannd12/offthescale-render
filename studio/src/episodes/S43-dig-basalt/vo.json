[
  {
    "scene": "cold",
    "index": 0,
    "text": "Seismic surveys said the drill would hit a layer of basalt, at around seven kilometres down.",
    "file": "S43-dig-basalt/vo/cold-00-e4deddc503.wav",
    "seconds": 5.11,
    "pauseAfter": 0.55
  },
  {
    "scene": "cold",
    "index": 1,
    "text": "The plan was to go through it, all the way to fifteen kilometres.",
    "file": "S43-dig-basalt/vo/cold-01-62bd4dac3d.wav",
    "seconds": 3.11,
    "pauseAfter": 0.55
  },
  {
    "scene": "cold",
    "index": 2,
    "text": "So they drilled.",
    "file": "S43-dig-basalt/vo/cold-02-5de3741ac2.wav",
    "seconds": 0.76,
    "pauseAfter": 0.55
  },
  {
    "scene": "cold",
    "index": 3,
    "text": "They passed seven kilometres, then seven and a half.",

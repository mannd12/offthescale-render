    "seconds": 6.529958333333333,
    "pauseAfter": 0.55
  },
  {
    "scene": "cold",
    "index": 1,
    "text": "The asteroid is Vesta, about five hundred kilometres across.",
    "file": "S50-too-tall-world/vo/cold-01-2c9729b026.wav",
    "seconds": 3.45,
    "pauseAfter": 0.55
  },
  {
    "scene": "cold",
    "index": 2,
    "text": "From its surface to its centre is only about two hundred and sixty kilometres.",

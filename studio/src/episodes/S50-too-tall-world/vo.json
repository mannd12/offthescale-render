    "seconds": 4.13,
    "pauseAfter": 0.55
  },
  {
    "scene": "cold",
    "index": 3,
    "text": "So that mountain would be taller than the world beneath it.",
    "file": "S50-too-tall-world/vo/cold-03-01d4cad675.wav",
    "seconds": 2.83,
    "pauseAfter": 0.55
  },
  {
    "scene": "cold",
    "index": 4,
    "text": "That can't be right.",
